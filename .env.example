# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="Givesplit Demo"
APP_TAGLINE="A need in. Parts people can say yes to out."
APP_DESCRIPTION="An open source, single-feature demo of Givesplit."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_givesplit_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
AI_CALLS_PER_USER_PER_DAY=50
# A split is 8-14 parts of JSON, and gemini-2.5-flash thinks before it answers: allow longer than the 15s default.
AI_GLOBAL_TIMEOUT_SECONDS=45
