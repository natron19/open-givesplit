<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1"><%= @need.heading %></h1>
    <p class="text-muted small mb-0">
      <%= link_to "← My needs", needs_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @need.kind_labels.join(" · ") %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_need_path(@need), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", need_path(@need),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this need and its splits?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card mb-4" style="max-width: 820px;">
  <div class="card-body">
    <p class="need-text mb-3"><%= @need.need_text %></p>
    <dl class="row mb-0 small">
      <dt class="col-sm-4 text-muted">Kinds of Part</dt>
      <dd class="col-sm-8"><%= @need.kind_labels.join(", ") %></dd>
      <dt class="col-sm-4 text-muted">Currency</dt>
      <dd class="col-sm-8"><%= @need.currency %></dd>
      <dt class="col-sm-4 text-muted">Rough budget</dt>
      <dd class="col-sm-8"><%= @need.rough_budget.presence || "Not stated" %></dd>
      <dt class="col-sm-4 text-muted">About the community</dt>
      <dd class="col-sm-8 mb-0"><%= @need.community_context.presence || "Not stated" %></dd>
    </dl>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "needs/split_button", need: @need, label: "Split into parts", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    The split reads only the need above, never who wrote it. It suggests a project name, a short description, and
    eight to fourteen Parts using only the kinds you ticked, at least half of them not money. Amounts it estimates
    are marked as guesses. Money never moves through this app. Typically takes 10&ndash;20 seconds.
  </p>
</div>

<% if @parts_plans.any? %>
  <h2 class="h6 text-muted mb-2">Earlier splits</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @parts_plans.each do |plan| %>
      <li class="mb-2">
        <%= link_to need_parts_plan_path(@need, plan) do %>
          <%= plan.generated_at ? "#{time_ago_in_words(plan.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if plan.completed? %>
          <%= render "needs/plan_badges", plan: plan %>
        <% else %>
          <span class="text-muted fst-italic"><%= plan.failed? ? "could not be used" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
